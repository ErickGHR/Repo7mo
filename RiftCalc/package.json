{
  "name": "riftcalc",
  "version": "0.2.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "dev": "expo start --web",
    "start": "expo start --go --lan",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "expo export --platform web",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "data:update": "node scripts/update-data.mjs",
    "data:stats": "node scripts/update-champion-stats.mjs",
    "data:abilities": "node scripts/fetch-abilities.mjs && node scripts/import-abilities.mjs",
    "data:audit": "tsx scripts/audit-abilities.ts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "expo": "^57.0.26",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "~19.2.4",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
}
