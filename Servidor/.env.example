# Copia este archivo a .env. Sustituye usuario y contraseña con los de Atlas.
# Usa la URI de Atlas > Connect > Drivers; no pegues comandos de mongosh.
MONGODB_URI=mongodb+srv://pimpollo:CONTRASENA@cluster0.74cqvs5.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=sample_mflix
PORT=3000

# Para MongoDB local, reemplaza MONGODB_URI por:
# MONGODB_URI=mongodb://127.0.0.1:27017
